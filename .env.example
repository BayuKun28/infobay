# ==============================================================================
# INFOBAY CENTRAL ENVIRONMENT TEMPLATE (.env.example)
# Duplicate to .env and configure values before starting development or production
# ==============================================================================

# ------------------------------------------------------------------------------
# PORTS & NETWORK ORCHESTRATION
# ------------------------------------------------------------------------------
PORT_BACKEND=8000
PORT_FRONTEND=9000

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite Client Exposed: VITE_*)
# ------------------------------------------------------------------------------
VITE_APP_NAME="infobay"
VITE_API_URL="/api/v1"
VITE_STORAGE_URL="/storage"
VITE_BASE_URL="http://127.0.0.1:9000"

# ------------------------------------------------------------------------------
# BACKEND CORE (Laravel 13)
# ------------------------------------------------------------------------------
APP_NAME=infobay
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL 17)
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=infobay
DB_USERNAME=infobay_user
DB_PASSWORD=your_secure_password_here

# ------------------------------------------------------------------------------
# SESSION & CACHE CONFIGURATION
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# ------------------------------------------------------------------------------
# MAIL SERVICE (Local / Logging)
# ------------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="admin@baydev.my.id"
MAIL_FROM_NAME="${APP_NAME}"
